<?xml version="1.0" encoding="UTF-8"?>
<config>
    <router>
        <hostname>LAB-RA04-C02-R01</hostname>

        <interface>
            <name>GigabitEthernet0/0/0.10</name>
            <description>VLAN 10 - Users network</description>
            <encapsulation>
                <dot1Q>10</dot1Q>
            </encapsulation>
            <ip>
                <address>172.16.10.1</address>
                <subnet-mask>255.255.255.0</subnet-mask>
            </ip>
        </interface>

        <interface>
            <name>GigabitEthernet0/0/0.20</name>
            <description>VLAN 20 - Servers network</description>
            <encapsulation>
                <dot1Q>20</dot1Q>
            </encapsulation>
            <ip>
                <address>172.16.20.1</address>
                <subnet-mask>255.255.255.0</subnet-mask>
            </ip>
        </interface>

        <interface>
            <name>GigabitEthernet0/0/0.30</name>
            <description>VLAN 30 - Management network</description>
            <encapsulation>
                <dot1Q>30</dot1Q>
            </encapsulation>
            <ip>
                <address>172.16.30.1</address>
                <subnet-mask>255.255.255.0</subnet-mask>
            </ip>
        </interface>

        <routing>
            <ospf>
                <process-id>1</process-id>
                <router-id>1.1.1.1</router-id>

                <network>
                    <ip>172.16.10.0</ip>
                    <wildcard>0.0.0.255</wildcard>
                    <area>0</area>
                </network>

                <network>
                    <ip>172.16.20.0</ip>
                    <wildcard>0.0.0.255</wildcard>
                    <area>0</area>
                </network>

                <network>
                    <ip>172.16.30.0</ip>
                    <wildcard>0.0.0.255</wildcard>
                    <area>0</area>
                </network>
            </ospf>
        </routing>

        <security>
            <banners>
                <exec>WAARSCHUWING: Ongeautoriseerde toegang is verboden. Alle activiteiten worden gecontroleerd.</exec>
                <login>Alleen geautoriseerde gebruikers hebben toegang. Verbreek de verbinding indien u geen toestemming heeft.</login>
                <motd>Welkom op LAB-RA04-C02-R01 - Toegang is beperkt tot netwerkbeheerders.</motd>
            </banners>
            <message-of-the-day>Netwerktoegang is uitsluitend toegestaan voor bevoegde gebruikers.</message-of-the-day>
        </security>
    </router>
</config>
