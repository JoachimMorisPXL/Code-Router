import requests
from ncclient import manager

"cm"># Verbindingsinstellingen
HOST     = "192.168.1.1"
USERNAME = "admin"
PASSWORD = "cisco"

"cm"># GitHub URL naar raw XML configuratiebestand
GITHUB_RAW_URL = (
    "https://raw.githubusercontent.com/"
    "https://github.com/JoachimMorisPXL/Code-Router/tree/main"
    "configs/router-config.xml"
)

def haal_config_op_van_github(url):
    """Haal XML configuratie op uit GitHub."""
    print(f"Config ophalen van: {url}")
    response = requests.get(url, timeout=10)
    response.raise_for_status()
    return response.text

def deploy_via_netconf(config_xml):
    """Deploy de configuratie via NETCONF candidate datastore."""
    with manager.connect(
        host=HOST, port=830,
        username=USERNAME, password=PASSWORD,
        hostkey_verify=False
    ) as m:
        m.lock(target="candidate")
        try:
            print("Config schrijven naar candidate datastore...")
            m.edit_config(target="candidate", config=config_xml)
            
            print("Valideren...")
            m.validate(source="candidate")
            
            print("Committen naar running...")
            m.commit()
            print("Deployment succesvol!")
            
        except Exception as e:
            print(f"Fout: {e}")
            print("Wijzigingen worden teruggedraaid (discard-changes)...")
            m.discard_changes()
            raise
        finally:
            m.unlock(target="candidate")

"cm"># Hoofdprogramma
if __name__ == "__main__":
    try:
        config = haal_config_op_van_github(GITHUB_RAW_URL)
        deploy_via_netconf(config)
    except requests.RequestException as e:
        print(f"GitHub niet bereikbaar: {e}")
    except Exception as e:
        print(f"Deployment mislukt: {e}")
